# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console HTML verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase (optional — enables accounts, cloud watch history and resume)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# TMDB
NEXT_PUBLIC_TMDB_KEY=your-tmdb-v3-api-key
NEXT_PUBLIC_TMDB_READ_TOKEN=your-tmdb-v4-read-token
